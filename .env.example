# URL de conexión PostgreSQL (Supabase u otro proveedor)
DATABASE_URL="postgresql://usuario:password@host:5432/nombre_db"

# ── JWT
JWT_SECRET_ACCESS="cambiar_por_un_secreto_aleatorio_seguro"
JWT_SECRET_REFRESH="cambiar_por_otro_secreto_aleatorio_seguro"
JWT_EXPIRATION_ACCESS="15m"
JWT_EXPIRATION_REFRESH="7d"

# ── Servidor
PORT="4000"
URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"

# "true" para requerir JWT en rutas protegidas
USE_AUTH="true"

# ── Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="tu_email@gmail.com"
# Contraseña de aplicación de Google 
SMTP_PASS="xxxx_xxxx_xxxx_xxxx"

# Remitente por defecto que aparece en los emails
MAIL_FROM="Posada Dormis <tu_email@gmail.com>"

# Email donde la posada recibe notificaciones de nuevas reservas
MAIL_ADMIN="admin@tuposada.com"

# "development" | "production"
NODE_ENV="development"
